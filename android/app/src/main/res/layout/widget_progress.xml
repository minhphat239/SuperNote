<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_glass_bg">

    <!-- Clock Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/widget_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FF00F5FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widget_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/01"
            android:textColor="#60FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:background="#20FFFFFF" />

    <!-- Progress Section -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/widget_progress_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiến độ hôm nay"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FF00F5FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar Background -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@drawable/widget_progress_bg">

            <!-- Progress Bar Fill -->
            <View
                android:id="@+id/widget_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_progress_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0/0 việc đã hoàn thành"
            android:textColor="#50FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
