<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3300F5FF" />
            <size android:width="52dp" android:height="52dp" />
        </shape>
    </item>
    <!-- Inner button -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#FF00F5FF"
                android:endColor="#FFFF007F"
                android:angle="135" />
        </shape>
    </item>
</layer-list>
